+// IRL4YOU: Kennzahlen für die Oberfläche ("Details" im Status). Die Datei (JSON, einmal je Sekunde neu geschrieben) nennt die Umgebungsvariable
+// BELACODER_STATS_FILE; ohne sie passiert nichts. Quellen: SRT-Statistik der Verbindung und die Zahl der Bilder, die der Encoder liefert.
+#include <sys/stat.h>
+static const char *stats_file = NULL;
+static volatile long enc_frames = 0;
+
+static GstPadProbeReturn enc_frame_probe(GstPad *pad, GstPadProbeInfo *info, gpointer data) {
+  enc_frames++;
+  return GST_PAD_PROBE_OK;
+}
+
+static gboolean write_stats(gpointer data) {
+  static long last_frames = 0;
+  static double last_t = 0;
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  double now = ts.tv_sec + ts.tv_nsec / 1e9;
+  long f = enc_frames;
+  double fps = (last_t > 0 && now > last_t) ? (double)(f - last_frames) / (now - last_t) : 0;
+  last_frames = f;
+  last_t = now;
+  SRT_TRACEBSTATS st;
+  int have = sock != -1 && srt_bistats(sock, &st, 0, 0) == 0;
+  char buf[640];
+  int n = snprintf(buf, sizeof(buf),
+      "{\"time\":%ld,\"fps\":%.1f,\"bitrate_kbps\":%d,\"rtt_ms\":%.1f,\"send_mbps\":%.2f,\"snd_buf_pkts\":%d,\"snd_buf_ms\":%d,"
+      "\"retrans_total\":%d,\"loss_total\":%d,\"drop_total\":%d,\"sent_total\":%lld}\n",
+      (long)time(NULL), fps, cur_bitrate / 1000,
+      have ? st.msRTT : -1.0, have ? st.mbpsSendRate : -1.0, have ? st.pktSndBuf : -1, have ? st.msSndBuf : -1,
+      have ? st.pktRetransTotal : -1, have ? st.pktSndLossTotal : -1, have ? st.pktSndDropTotal : -1,
+      have ? (long long)st.pktSentTotal : -1LL);
+  if (n > 0 && n < (int)sizeof(buf)) {
+    char tmp[512];
+    snprintf(tmp, sizeof(tmp), "%s.tmp", stats_file);
+    FILE *fp = fopen(tmp, "w");
+    if (fp) {
+      fwrite(buf, 1, (size_t)n, fp);
+      fclose(fp);
+      chmod(tmp, 0644);
+      rename(tmp, stats_file);
+    }
+  }
+  return TRUE;
+}
+
 int main(int argc, char** argv) {
   int opt;
   char *srt_host = NULL;
