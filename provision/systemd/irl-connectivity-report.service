[Unit]
Description=IRL Streamer OS - Relay-Tunnel aufbauen/verifizieren (Ampel rot/gruen) + Report an Lizenzserver
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
# V1.87: KEIN ExecCondition mehr. Der Lauf besteht meist nur aus einem lokalen
# Ping auf das Relay-Gateway (stoert keinen Stream) und soll die Ampel auch
# WAEHREND eines Streams binnen <= 2 Minuten auf rot setzen. Der einzige
# stoerende Teil (Tunnel neu aufbauen = wg-quick restart) wird im Skript selbst
# uebersprungen, solange ein Stream aktiv ist (irl-stream-active-check.sh).
# Baut den WireGuard-Relay-Tunnel auf (falls noch nicht vorhanden) und
# verifiziert ihn per Handshake+Echo-Test - Ergebnis in
# state/relay-provision.json (verified: true/false). Kein separater
# lokaler Erreichbarkeitscheck mehr noetig, siehe Modul-Kommentar im
# Skript selbst.
ExecStart=/bin/bash /opt/irl-streamer-os/provision/irl-connectivity-report-client.sh
