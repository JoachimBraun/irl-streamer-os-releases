[Unit]
Description=IRL Streamer OS - Relay-Tunnel minuetlich aufbauen/verifizieren

[Timer]
# Nutzerwunsch 06.09.: Ampel (rot/gruen) soll binnen kurzer Zeit auf Ausfaelle
# reagieren. V1.87: der Minutenlauf ist jetzt ein reiner LOKALER Check (Ping auf
# das Relay-Gateway 10.8.0.1, kein Server-Request); Ausfall -> ROT in <= 2 Min
# (1 Min Timer + ~3 s Ping). Server-Kontakt nur stuendlich (+Jitter), bei
# Erholung oder mit Backoff nach Fehlern - siehe provision/lib/relay-health.py.
OnBootSec=1min
OnUnitActiveSec=1min
Persistent=true
Unit=irl-connectivity-report.service

[Install]
WantedBy=timers.target
